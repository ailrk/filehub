cabal-version:            3.0
name:                     filehub
version:                  0.1.3.0
author: Ailrk
maintainer:               jimmy@ailrk.com
build-type:               Simple
data-files:               data/**/*.css
                          data/**/*.js
                          data/**/*.png
                          data/**/*.ico


flag debug
  description:            Enable debug mode
  default:                False
  manual:                 True


common shared
  default-extensions:     BlockArguments
                          DataKinds
                          DerivingStrategies
                          DerivingVia
                          DeriveGeneric
                          DeriveAnyClass
                          GeneralizedNewtypeDeriving
                          DuplicateRecordFields
                          FlexibleContexts
                          GADTs
                          ImportQualifiedPost
                          KindSignatures
                          LambdaCase
                          NoFieldSelectors
                          OverloadedLabels
                          OverloadedRecordDot
                          OverloadedStrings
                          QuasiQuotes
                          RankNTypes
                          RecordWildCards
                          ScopedTypeVariables
                          StandaloneDeriving
                          StrictData
                          TypeApplications
                          TypeOperators
                          TypeFamilies
                          FlexibleInstances

  -- Force all warnings to be on and selectively disable some
  ghc-options:            -Weverything
                          -Wno-all-missed-specialisations
                          -Wno-ambiguous-fields
                          -Wno-implicit-prelude
                          -Wno-missing-deriving-strategies
                          -Wno-missing-export-lists
                          -Wno-missing-import-lists
                          -Wno-missing-kind-signatures
                          -Wno-missing-local-signatures
                          -Wno-missing-safe-haskell-mode
                          -Wno-missing-role-annotations
                          -Wno-partial-fields
                          -Wno-monomorphism-restriction
                          -Wno-safe
                          -Wno-unsafe
                          -Wno-unticked-promoted-constructors
                          -threaded

  build-depends:          base >=4.16.1.0
                        , breakpoint
                        , aeson
                        , bytestring
                        , text

  default-language:       Haskell2010

  if flag(debug)
    cpp-options:          -DDEBUG
    ghc-options:          -fplugin Debug.Breakpoint


library
  import:                 shared
  hs-source-dirs:         filehub
  build-depends:          filehub:filehub-core,
                          log-base,
                          optparse-applicative,
                          split,
                          network-uri,
                          filehub:filehub-utils,
                          tomland,
                          string-interpolate,
                          time,
                          filehub:filehub-server,
                          http-client-tls,
                          warp,
                          servant-conduit,
                          unliftio
  exposed-modules:        Filehub
                          Filehub.Config
                          Filehub.Config.Options
                          Filehub.Config.Toml
                          Paths_filehub

library filehub-utils
  import:                 shared
  hs-source-dirs:         filehub-utils
  build-depends:          hashable,
                          string-interpolate,
                          sqlite-simple,
                          unliftio,
                          time,
                          http-api-data,
                          mime-types,
                          case-insensitive,
                          containers,
                          http-types,
                          wai,
                          wai-extra,
                          servant-server,
                          servant,
                          network-uri,
                          uuid,
                          jwt,
                          psqueues,
                          vector,
                          lucid,
                          uri-encode,
                          filepath,
                          conduit,
                          servant-multipart
  exposed-modules:        Cache.InMemory
                          Cache.Key
                          Control.Handle.Cache
                          Control.Handle.EvtLog
                          Control.Handle.LockManager
                          Control.Handle.Storage
                          Control.Service.Cache
                          Control.Service.LockManager
                          Data.ClientPath
                          Data.ClientPath.IO
                          Data.ClientPath.View
                          Data.File
                          Data.Queue
                          LockManager.Key
                          LockManager.Local
                          Lucid.Htmx
                          Network.Mime.Extended
                          Network.HTTP.Headers.Extended
                          Network.Wai.Middleware.Extended
                          Paths_filehub
                          Servant.Extended
                          System.FilePath.Extended
                          Text.Debug
                          Worker.Pool
                          Worker.Task

library filehub-core
  import:                 shared
  hs-source-dirs:         filehub-core
  build-depends:          uuid,
                          hashable,
                          unliftio,
                          containers,
                          filehub:filehub-utils,
                          generic-lens,
                          servant-server,
                          http-api-data,
                          file-embed,
                          tomland,
                          time,
                          log-base,
                          aeson-pretty,
                          servant-event-stream,
                          lucid,
                          servant,
                          network-uri,
                          template-haskell,
                          cryptohash-sha256,
                          vector,
                          filepath,
                          string-interpolate,
                          uri-encode,
                          servant-conduit,
                          jwt,
                          amazonka,
                          amazonka-core,
                          amazonka-s3,
                          hashtables,
                          timers,
                          http-client,
                          stm,
                          cookie,
                          mtl,
                          resourcet,
                          transformers-base,
                          zip,
                          conduit,
                          microlens,
                          mime-types,
                          servant-multipart,
                          temporary,
                          conduit-extra,
                          retry,
                          suspend,
                          wai,
                          transformers,
                          http-types,
                          bcrypt,
                          cryptonite,
                          base64-bytestring,
                          servant-client,
                          servant-lucid,
                          random
  exposed-modules:
                          Filehub.ActiveUser.Pool
                          Filehub.ActiveUser.Types
                          Filehub.Auth.OIDC
                          Filehub.Auth.Simple
                          Filehub.Auth.Types
                          Filehub.Auth.Types.AuthId
                          Filehub.Auth.Types.OIDC
                          Filehub.Auth.Types.Simple
                          Filehub.Cookie
                          Filehub.Display
                          Filehub.Env
                          Filehub.Error
                          Filehub.Handler
                          Filehub.Locale
                          Filehub.Log
                          Filehub.Monad
                          Filehub.Notification.Types
                          Filehub.Orphan
                          Filehub.QQ
                          Filehub.Routes
                          Filehub.Routes.LinkConf
                          Filehub.Routes.Links
                          Filehub.Session
                          Filehub.Session.Copy
                          Filehub.Session.Handle
                          Filehub.Session.Internal
                          Filehub.Session.Pool
                          Filehub.Session.Selected
                          Filehub.Session.Types
                          Filehub.Session.Types.SessionId
                          Filehub.SharedLink
                          Filehub.Size
                          Filehub.Sort
                          Filehub.Storage.File
                          Filehub.Storage.S3
                          Filehub.Theme
                          Filehub.Types
                          Filehub.UserAgent
                          Paths_filehub
                          Target.Dummy
                          Target.File
                          Target.S3
                          Target.Types

library filehub-server
  import:                 shared
  hs-source-dirs:         filehub-server
  build-depends:          string-interpolate,
                          time,
                          uuid,
                          filehub:filehub-core,
                          filehub:filehub-templates,
                          log-base,
                          lucid,
                          http-types,
                          network-uri,
                          servant-server,
                          unliftio,
                          cookie,
                          conduit,
                          containers,
                          servant-event-stream,
                          filehub:filehub-utils,
                          file-embed,
                          mtl,
                          cryptohash-sha256,
                          base64-bytestring,
                          mime-types,
                          filepath,
                          stm,
                          zip,
                          binary,
                          wai,
                          servant-multipart,
                          directory,
                          temporary,
                          random,
                          wai-extra
  exposed-modules:        Filehub.Server
                          Filehub.Server.File
                          Filehub.Server.File.Paste
                          Filehub.Server.File.Delete
                          Filehub.Server.Login
                          Filehub.Server.Notification
                          Filehub.Server.Search
                          Filehub.Server.SharedLink
                          Filehub.Server.Static
                          Filehub.Server.Static.QQ
                          Filehub.Server.UI
                          Filehub.Server.UI.Render
                          Filehub.Server.UI.Action
                          Filehub.Server.UI.Platform.Desktop
                          Filehub.Server.UI.Platform.Mobile
                          Filehub.Server.Util


library filehub-templates
  import:                 shared
  hs-source-dirs:         filehub-templates
  build-depends:          mtl,
                          filehub:filehub-utils,
                          filehub:filehub-core,
                          unliftio,
                          lucid,
                          servant-server,
                          containers,
                          string-interpolate,
                          filepath,
                          fuzzy,
                          time
  exposed-modules:        Filehub.Template
                          Filehub.Template.Desktop
                          Filehub.Template.Htmx
                          Filehub.Template.Login
                          Filehub.Template.Mobile
                          Filehub.Template.Shared


executable filehub
  import:                 shared
  main-is:                Main.hs
  hs-source-dirs:         app
  build-depends:          filehub


test-suite filehub_test_integration
  import:                 shared
  type:                   exitcode-stdio-1.0
  hs-source-dirs:         test_integration
  main-is:                Main.hs
  other-modules:          Test.Middleware
                          Test.Cache
                          Test.Api.Login
                          Test.Api.File
                          Util.Env
  build-depends:          QuickCheck
                        , bcrypt
                        , containers
                        , cookie
                        , directory
                        , filehub
                        , filepath
                        , hspec
                        , hspec-wai
                        , http-api-data
                        , http-types
                        , http-client
                        , http-client-tls
                        , log-base
                        , servant-server
                        , time
                        , uri-encode
                        , uuid
                        , unliftio
                        , wai
                        , wai-extra
                        , filehub:filehub-utils
                        , filehub:filehub-core
                        , filehub:filehub-server


test-suite filehub_test_unit
  import:                 shared
  type:                   exitcode-stdio-1.0
  hs-source-dirs:         test_unit
  main-is:                Spec.hs
  other-modules:          Data.ClientPathSpec
                          EvtLogSpec
  build-depends:          QuickCheck
                        , filehub
                        , filehub-utils
                        , filepath
                        , hspec
                        , time
                        , uri-encode
                        , filehub:filehub-core


benchmark filehub_bench
  import:                 shared
  type:                   exitcode-stdio-1.0
  hs-source-dirs:         benchmark
  main-is:                Main.hs
  build-depends:          filehub
                        , filehub-utils
                        , criterion >=1.6
                        , unliftio
                        , req
                        , time
                        , http-types
